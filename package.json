{
  "name": "disaster-alert-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace frontend\" \"npm:dev --workspace backend\"",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}